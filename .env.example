# Groq API key (https://console.groq.com/keys). Required. FBA_GROQ_API_KEY takes precedence over a
# generic GROQ_API_KEY that may already be exported in your shell.
FBA_GROQ_API_KEY=

# Model fallback chain, highest priority first. The router switches to the next model when one
# hits its rate limit, is unavailable, or cannot fit the request.
FBA_MODELS=["qwen/qwen3.8-27b","openai/gpt-oss-120b","openai/gpt-oss-20b","allam-2-7b"]

# FIREBRIDGE public API used to load analyses by id.
FBA_FIREBRIDGE_API_URL=https://astramind.solutions/api/v1

# SQLite file for sessions, messages, memories and cached evidence.
FBA_DATABASE_PATH=data/agent.db

# Optional: comma-separated keys clients must send in X-API-Key. Empty disables auth (local use).
FBA_SERVICE_API_KEYS=[]

# Requests per minute per client (API key or IP).
FBA_RATE_LIMIT_PER_MINUTE=30

# Long-term memory extraction after chat turns (one extra small LLM call, in the background).
FBA_MEMORY_EXTRACTION=true

FBA_LOG_LEVEL=INFO
FBA_LOG_JSON=true

# Production requires both a Groq key and non-empty service keys. Set by production Compose.
FBA_ENVIRONMENT=development
